+async def test_rerank_reorders_hits(
+    service: KbService,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """AC1：精排结果被采用——stub 逆序 → 输出首条=原候选末条。"""
+    import qwenpaw.app.kb.rerank as rerank_mod
+    from qwenpaw.app.kb.tool import make_kb_search_tool
+
+    a = service.create_kb("甲库", scope=SCOPE_ENTERPRISE)
+    _bind(monkeypatch, [a.id])
+    c1 = _mk_chunk("d1", 0, "低分块", "", kb_id=a.id)
+    c2 = _mk_chunk("d1", 1, "高分块", "", kb_id=a.id)
+    # S1 融合后按 score 降序：[高分块(0.9), 低分块(0.5)]
+    monkeypatch.setattr(
+        service,
+        "search",
+        lambda kb_id, query, **kw: [(c2, 0.9), (c1, 0.5)],
+    )
+
+    async def _reverse(query, hits, top_n=5, agent_id=""):
+        return list(reversed(list(hits)))[: max(1, top_n)]
+
+    monkeypatch.setattr(rerank_mod, "rerank_hits", _reverse)
+
+    tool = make_kb_search_tool(service, "agent_x")
+    text = _hit_text(await tool("块"))
+    # 精排逆序被采用 → 低分块排到高分块前
+    assert text.index("低分块") < text.index("高分块")
+
