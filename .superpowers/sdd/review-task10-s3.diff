+async def test_rerank_degrades_to_rrf_order(
+    service: KbService,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """AC2：passthrough（缺凭证降级）→ RRF 序、score 降序。"""
+    import re
+
+    from qwenpaw.app.kb.tool import make_kb_search_tool
+
+    a = service.create_kb("甲库", scope=SCOPE_ENTERPRISE)
+    _bind(monkeypatch, [a.id])
+    c1 = _mk_chunk("d1", 0, "次优块", "", kb_id=a.id)
+    c2 = _mk_chunk("d1", 1, "最优块", "", kb_id=a.id)
+    monkeypatch.setattr(
+        service,
+        "search",
+        lambda kb_id, query, **kw: [(c2, 0.9), (c1, 0.5)],
+    )
+    # autouse _stub_rerank 已钉 passthrough（模拟缺凭证降级）
+    tool = make_kb_search_tool(service, "agent_x")
+    text = _hit_text(await tool("块"))
+    # 降级保 RRF 序：高分在前
+    assert text.index("最优块") < text.index("次优块")
+    scores = [float(m) for m in re.findall(r"score=([0-9.]+)", text)]
+    assert scores == sorted(scores, reverse=True)
+
