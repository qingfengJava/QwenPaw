+async def test_rerank_before_section_expand(
+    service: KbService,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """AC5：先精排选定 top，再对选定命中 expand=section 富化。"""
+    import qwenpaw.app.kb.rerank as rerank_mod
+    from qwenpaw.app.kb.tool import make_kb_search_tool
+
+    a = service.create_kb("甲库", scope=SCOPE_ENTERPRISE)
+    _bind(monkeypatch, [a.id])
+    # 两个不同小节：A 节（RRF 高分 seq0）、B 节（RRF 低分 seq5）
+    hA = _mk_chunk("d1", 0, "A节内容", "A标题", kb_id=a.id)
+    hB = _mk_chunk("d1", 5, "B节内容", "B标题", kb_id=a.id)
+    monkeypatch.setattr(
+        service,
+        "search",
+        lambda kb_id, query, **kw: [(hA, 0.9), (hB, 0.5)],
+    )
+
+    # 精排把 RRF 低分的 B 节选为 top1（逆 RRF 序）
+    async def _pick_b(query, hits, top_n=5, agent_id=""):
+        return [hits[1]][: max(1, top_n)]
+
+    monkeypatch.setattr(rerank_mod, "rerank_hits", _pick_b)
+    monkeypatch.setattr(
+        service,
+        "document_chunks",
+        lambda kb_id, doc_id: [hA, hB],
+        raising=False,
+    )
+
+    tool = make_kb_search_tool(service, "agent_x")
+    text = _hit_text(await tool("节", max_results=1, expand="section"))
+    # 精排选定 B 节 → 输出是 B 节内容，而非 RRF 高分的 A 节
+    # （证明精排在扩展前先选定 top；若扩展先于精排则会出 A 节）
+    assert "B节内容" in text
+    assert "A节内容" not in text
+    # 精排 top_n=1 → 只一条结果
+    assert text.count("[score=") == 1
