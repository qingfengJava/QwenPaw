+async def test_rerank_overfetches_candidates(
+    service: KbService,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """AC3：svc.search 以 top_k=20（候选池）被调用，非 cap。"""
+    from qwenpaw.app.kb.tool import make_kb_search_tool
+
+    a = service.create_kb("甲库", scope=SCOPE_ENTERPRISE)
+    _bind(monkeypatch, [a.id])
+    service.ingest_text(a.id, "deployment runbook", title="甲文档")
+    seen: dict = {}
+    orig = service.search
+
+    def _spy(kb_id, query, **kw):
+        seen.update(kw)
+        return orig(kb_id, query, **kw)
+
+    monkeypatch.setattr(service, "search", _spy)
+
+    tool = make_kb_search_tool(service, "agent_x")
+    await tool("deployment", max_results=3)
+    # 候选池为精排拓宽到 20（而非 max_results=3）
+    assert seen.get("top_k") == 20
